<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <ul>
            <% categories.forEach(category=> { %>
                <li><a href="/category/<%= category.id %>">
                        <%= category.category %>
                    </a></li>
                <% });%>
        </ul>
        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/new-category" class="action-link">New category</a></p>
            <% } %>
        
    </main>
    <%- include('partials/footer') %>