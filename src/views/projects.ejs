<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach( project=> {%>
                <li>
                    <%= project.service_date %>: <a href="/project/<%= project.id %>">
                            <%= project.title %>
                        </a> (<a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>)
                </li>
                <% }); %>
        </ul>
        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/new-project" class="action-link">Add a New Service Project</a></p>
            <% } %>
        
    </main>
    <%- include('partials/footer') %>