<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= projectDetails.title %>
        </h2>
        <p><strong>Description:</strong>
            <%= projectDetails.description %>
        </p>
        <p><strong>Fecha:</strong>
            <%= projectDetails.service_date %>
        </p>
        <p><strong>Location:</strong>
            <%= projectDetails.location %>
        </p>

        <a href="/organization/<%= projectDetails.organization_id %>">
            <%= projectDetails.organization_name %>
        </a>
        <h3>Categories: </h3>
        <ul>
            <% categories.forEach(category=> { %>
                <li><a href="/category/<%= category.category_id %>">
                        <%= category.category %>
                    </a></li>
                <% }); %>
        </ul>
        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/edit-project/<%= projectDetails.id %>" class="action-link">Edit Project</a></p>
            <a href="/assign-categories/<%= projectDetails.id %>" class="action-link">Edit Categories</a>
            <% } %>
        <% if (isLoggedIn) { %>
            <% if (volunteered) { %>
                <a href="/remove-volunteer/<%= projectDetails.id %>" class="action-link">Remove from project</a>
            <% } else { %>
                <a href="/volunteer/<%= projectDetails.id %>" class="action-link">Volunteer</a>
            <% } %>
        <% } %>
        
    </main>
    <%- include('partials/footer') %>