<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <p><strong>Category Name:</strong>
            <%= category.category %>
        </p>
        <p><strong>Projects: </strong></p>
        <ul>
        <% projects.forEach(project=> { %>
            <li>
                <a href="/project/<%= project.project_id %>"><%= project.title %></a>
            </li>
            <% });%>
        </ul>

    </main>
    <%- include('partials/footer') %>